# Twilio is optional. Leave these unset for the demo: alerts are logged, not sent.
# Set all four to send one real SMS and one real call per fire.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=
ALERT_PHONE=

# Free-tier knobs. Render's blueprint sets the same defaults.
FRAME_STRIDE=4
YOLO_IMGSZ=320
MAX_EDGE=480
MAX_UPLOAD_BYTES=8388608
MAX_DURATION_SEC=15
MAX_PROCESS_SEC=150
GRAPH_DPI=80
